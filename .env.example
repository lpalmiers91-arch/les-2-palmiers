# =====================================================================
#  Les 2 Palmiers — variables d'environnement (modèle)
#  Copier en .env.local (jamais committé). Les secrets vivent aussi
#  dans les réglages Vercel (frontend) et Supabase (Edge Functions).
# =====================================================================

# --- Application ------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://les2palmiers.site
NEXT_PUBLIC_APP_ENV=development            # development | preview | production
NEXT_PUBLIC_DEMO_MODE=true                 # bannières "Démonstration", paiement simulé

# --- CORS des Edge Functions (SEC-01) -------------------------------
# Liste blanche des origines autorisées à appeler les Edge Functions
# appelées depuis le navigateur (admin-invite, staff-booking, ai-assistant,
# ai-draft, ical-sync, notify), séparées par des virgules. Toute origine
# absente de cette liste se voit répondre le domaine par défaut (jamais
# reflétée telle quelle) — à définir comme secret Edge Function :
#   supabase secrets set ALLOWED_ORIGINS="https://www.les2palmiers.site,https://les2palmiers.site,https://staff.les2palmiers.site"
# (le domaine canonique réel est www — l'apex redirige vers www en 308)
ALLOWED_ORIGINS=https://www.les2palmiers.site,https://les2palmiers.site

# --- Cloisonnement client / équipe (isolation par hôte) -------------
# Laisser vide = hôte unique (les deux espaces coexistent, isolation par rôle).
# Renseigner pour séparer physiquement : l'espace équipe (/equipe, /staff, /admin)
# n'est alors servi QUE sur STAFF_HOST ; l'espace client QUE sur l'hôte principal.
STAFF_HOST=                               # ex. admin.les2palmiers.site
CLIENT_ORIGIN=                            # ex. https://les2palmiers.site
STAFF_ORIGIN=                             # ex. https://admin.les2palmiers.site (défaut: https://$STAFF_HOST)

# --- Supabase (public, côté navigateur) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Supabase (serveur uniquement — jamais exposé au client) --------
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=...
SUPABASE_DB_URL=postgresql://postgres:...@db.xxxxxxxx.supabase.co:5432/postgres

# --- Assistant IA : couche multi-fournisseurs -----------------------
# provider: anthropic | openai | google | mistral | openai-compatible | echo
AI_PROVIDER=echo
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=                              # requis pour openai-compatible (Groq, OpenRouter, Ollama, vLLM...)
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.4
AI_MONTHLY_BUDGET_USD=                    # optionnel : coupe-circuit de coût (appliqué dans
                                           # ai-assistant, cumul authentifié + anonyme ; laisser
                                           # vide = pas de plafond, seul le rate-limit par IP protège
                                           # les appels anonymes)

# Repli si le fournisseur principal échoue (optionnel)
AI_FALLBACK_PROVIDER=echo
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=

# Embeddings (base de connaissances) — souvent le même fournisseur
AI_EMBEDDINGS_PROVIDER=echo
AI_EMBEDDINGS_MODEL=
AI_EMBEDDINGS_API_KEY=

# --- Paiement (simulé en démo) -------------------------------------
PAYMENTS_PROVIDER=sim                     # sim | fedapay | kkiapay (plus tard)
PAYMENTS_WEBHOOK_SECRET=change-me         # signature du "webhook" du simulateur
# FEDAPAY_API_KEY=
# KKIAPAY_PUBLIC_KEY=
# KKIAPAY_PRIVATE_KEY=

# --- E-mail transactionnel ----------------------------------------
EMAIL_PROVIDER=log                        # log | resend | smtp   (log = n'envoie pas, écrit dans les logs)
# SEC-02 : ne JAMAIS coller de clé réelle ici, y compris en local. La clé
# Resend est un secret d'Edge Function — elle se pousse avec :
#   supabase secrets set RESEND_API_KEY=re_...
# et ne doit exister nulle part dans une copie de travail versionnée ou non.
RESEND_API_KEY=
EMAIL_FROM="Les 2 Palmiers <bonjour@les2palmiers.site>"
# Hook « Send Email » de Supabase Auth : la fonction auth-email rend tous les
# e-mails d'authentification à la marque, dans la langue du destinataire.
# Secret (Edge Function) : format "v1,whsec_<base64>" — identique à la valeur
# renseignée dans Auth > Hooks > Send Email.
SEND_EMAIL_HOOK_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Notifications push (Web Push / VAPID) ------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bonjour@les2palmiers.site

# --- Analytics (chargé seulement après consentement cookies) -----
NEXT_PUBLIC_ANALYTICS_PROVIDER=           # vercel | plausible | (vide = désactivé)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=les2palmiers.site

# --- WhatsApp (hors périmètre démo, prévu) -----------------------
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
